#version 410 core

// Вершинный шейдер для куба (программа cube).

in vec4 vPosition;  // позиция вершины (x, y, z)
in vec4 vColor;     // цвет вершины (у каждой грани свой)

// Сначала масштаб, потом поворот, потом перенос: uModel = T * R * S (собирается в программе).
uniform mat4 uModel;

out vec4 color;  // передаётся во фрагментный шейдер

void main() {
    // Камеры и матрицы проекции нет: используется стандартный ортографический объём -1..1.
    gl_Position = uModel * vPosition;
    color = vColor;
}
